# ClassPilot 后端环境变量示例（复制为 .env 后填写）
PORT=3000
# 生产（1Panel）示例：
# DB_PATH=/opt/classpilot/data/classpilot.db
# BACKUP_DIR=/opt/classpilot/backups
DB_PATH=./data/classpilot.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7
COOKIE_NAME=cp_token
# 仅 IP + HTTP 部署时必须 false；有 HTTPS 后改为 true 或删除本行
COOKIE_SECURE=false
# AES-256-GCM 密钥（32 字节 hex，共 64 字符）；L2 高敏读写时使用
AES_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 备份目录
BACKUP_DIR=./data/backups
# DeepSeek（评语生成；未配置时退化为占位草稿，核心 CRUD 仍可用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=60000
